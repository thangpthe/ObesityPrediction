# =============================================
#  ML / Data
# =============================================
# Ignore large datasets by default
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json

# Allow the official UCI obesity dataset
!data/raw/ObesityDataSet_raw_and_data_sinthetic.csv

# Keep processed test data (small)
!data/processed/test_data.csv

# Large model files - track with Git LFS
models/*.pkl
